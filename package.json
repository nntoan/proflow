{
	"name": "proflow-workspace",
	"version": "0.1.20",
	"private": true,
	"description": "Development workspace for proflow — the installer, the agent-skills payload, and the optional tool mods.",
	"license": "MIT",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"sync": "node scripts/sync-upstream.mjs",
		"sync:magento2": "node scripts/sync-magento2.mjs",
		"proflow:install": "node packages/cli/scripts/install.mjs install",
		"proflow:uninstall": "node packages/cli/scripts/install.mjs uninstall",
		"test": "node --disable-warning=ExperimentalWarning test/run.mjs",
		"release:check": "npm test && npm pack --dry-run --workspaces",
		"rates": "node packages/cli/scripts/rates.mjs"
	},
	"engines": {
		"node": ">=22.13"
	}
}
